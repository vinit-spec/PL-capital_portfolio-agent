# .env — Copy this file to .env and insert your Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the model (e.g. gemini-2.0-flash, gemini-1.5-flash, gemini-2.5-flash)
# Run `python list_available_models.py` to see models enabled on your key tier
GEMINI_MODEL=gemini-2.0-flash
